set_property PACKAGE_PIN T10 [get_ports {gpio_rtl_0_tri_o[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {gpio_rtl_0_tri_o[0]}]
# Red LED - P2 pin 1
set_property PACKAGE_PIN L14 [get_ports {GPIO2_0_tri_o[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {GPIO2_0_tri_o[0]}]

# Yellow LED - P2 pin 2
set_property PACKAGE_PIN L15 [get_ports {GPIO2_0_tri_o[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {GPIO2_0_tri_o[1]}]

# Green LED - P2 pin 3
set_property PACKAGE_PIN K14 [get_ports {GPIO2_0_tri_o[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {GPIO2_0_tri_o[2]}]
# Buzzer - P2 pin 4
set_property PACKAGE_PIN J14 [get_ports {GPIO2_0_tri_o[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {GPIO2_0_tri_o[3]}]